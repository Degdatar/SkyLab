; SkyLab settings — Data/SKSE/Plugins/SkyLab.ini (copy from this example)
[Hotkey]
; VK code: 0x76 = F7, 0x77 = F8, 0x78 = F9
KeyCode=0x76
; Modifier: 0 none, 1 shift, 2 ctrl, 4 alt
Modifier=0

[View]
ShowCollision=1
ShowWireframe=0
FOV=60

[General]
; Last opened NIF (auto-filled)
LastNif=
Theme=0

[Export]
; Empty writes to Skyrim Data (Vortex). For MO2, set the active instance's
; Overwrite folder, e.g. D:\ModOrganizer\instances\Skyrim SE\overwrite
Root=
